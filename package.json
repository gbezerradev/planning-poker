{
  "name": "ponto-next",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check-types": "npm run check-types --workspaces --if-present",
    "dev:web": "npm run dev --workspace web",
    "db:push": "npm run db:push --workspace @ponto-next/db",
    "db:studio": "npm run db:studio --workspace @ponto-next/db",
    "db:generate": "npm run db:generate --workspace @ponto-next/db",
    "db:migrate": "npm run db:migrate --workspace @ponto-next/db",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@ponto-next/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@ponto-next/config": "*",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.13.0"
}
